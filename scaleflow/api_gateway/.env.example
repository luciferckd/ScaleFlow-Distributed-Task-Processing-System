# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=scaleflow
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=5000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Observability & Logging
LOG_LEVEL=info
LOG_FORMAT=text
