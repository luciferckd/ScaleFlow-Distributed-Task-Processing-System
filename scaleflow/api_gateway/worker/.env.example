# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=scaleflow
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=5
DB_MAX_RETRIES=3

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAX_RETRIES=3

# Worker & Recovery Settings
WORKER_ID=worker-1
PUBLISHER_ID=publisher-1
RECOVERY_INTERVAL_SECONDS=30
CRASH_TEST=false

# Observability & Logging (text / json)
LOG_LEVEL=INFO
LOG_FORMAT=text
